# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
POSTGRES_USER=itam_user
POSTGRES_PASSWORD=itam_password_secret
POSTGRES_DB=itam_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Prisma Database URL (for docker / local)
# Local dev: postgresql://itam_user:itam_password_secret@localhost:5432/itam_db?schema=public
# Docker: postgresql://itam_user:itam_password_secret@postgres:5432/itam_db?schema=public
DATABASE_URL="postgresql://itam_user:itam_password_secret@localhost:5432/itam_db?schema=public"

# Authentication
JWT_SECRET=itam_super_secret_jwt_key_987654321_enterprise
JWT_EXPIRES_IN=8h

# Client App
FRONTEND_URL=http://localhost:3000
