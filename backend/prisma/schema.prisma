datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  EXITED
}

enum AssetType {
  LAPTOP
  DESKTOP
  WORKSTATION
  MONITOR
  KEYBOARD
  MOUSE
  HEADSET
  CHARGER
  ADAPTER
  OTHER
}

enum AssetStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  IN_USE
  UNDER_REPAIR
  DAMAGED
  LOST
  STOLEN
  RETURNED
  IN_TRANSIT
  RETIRED
  SCRAPPED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  CRITICAL
}

enum WorkflowStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
  RETURNED
  RECEIVED
  INSPECTED
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  REPORTED
  APPROVED
  IN_PROGRESS
  WAITING_PARTS
  WAITING_FOR_PARTS
  WAITING_VENDOR
  COMPLETED
  CANCELLED
}

enum AssetAction {
  CREATED
  ASSET_CREATED
  ASSET_IMPORTED
  ASSIGNED
  ASSET_ASSIGNED
  ASSIGNMENT_UPDATED
  TRANSFERRED
  ASSET_TRANSFERRED
  ASSET_RETURN_INITIATED
  RETURNED
  ASSET_RETURNED
  ASSET_INSPECTED
  MAINTENANCE_OPENED
  MAINTENANCE_STARTED
  MAINTENANCE_UPDATED
  MAINTENANCE_COMPLETED
  LOCATION_CHANGED
  DEPARTMENT_CHANGED
  HOLDER_CHANGED
  EMPLOYEE_CHANGED
  STATUS_CHANGED
  CONDITION_CHANGED
  ALLOCATION_CHANGED
  DISPOSITION_CHANGED
  HARDWARE_CHANGED
  DAMAGED
  LOST
  FOUND
  RETIRED
  ASSET_DEACTIVATED
  ASSET_REACTIVATED
  SCRAPPED
  CORRECTION_RECORDED
}

enum AllocationStatus {
  ALLOCATED
  NOT_ALLOCATED
}

enum AssetCriticality {
  HIGH
  MEDIUM
  LOW
  CRITICAL
  UNSPECIFIED
}

enum HolderType {
  EMPLOYEE
  SHARED
  ROOM
  POOL
  STOCK
  UNKNOWN
}

enum HolderVerificationStatus {
  VERIFIED
  NEEDS_REVIEW
  NON_EMPLOYEE_HOLDER
}

enum DataQualityStatus {
  CLEAN
  WARNING
  NEEDS_REVIEW
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  READY
  IMPORTED
  PARTIAL
  FAILED
}

enum ApprovalRequestType {
  ASSIGNMENT
  TRANSFER
  RETURN_DISPOSITION
  MAINTENANCE_COMPLETION
  ASSET_STATUS_CHANGE
  ASSET_DEACTIVATION
  ASSET_RETIREMENT
  SENSITIVE_UPDATE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
  EXPIRED
}

enum ApprovalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WarrantyType {
  STANDARD
  EXTENDED
  ONSITE
  DEPOT
  ACCIDENTAL_DAMAGE
  LIMITED
  SERVICE_CONTRACT
  OTHER
}

enum CoverageStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_SERVICE
  RESOLVED
  CANCELLED
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  name        String
  code        String           @unique
  module      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs            AuditLog[]
  notifications        Notification[]
  assignedByWorkflow   AssetAssignment[] @relation("AssignedByRelation")
  approvedByAssignment AssetAssignment[] @relation("ApprovedByAssignmentRelation")
  requestedTransfers   AssetTransfer[]   @relation("RequestedByTransferRelation")
  approvedTransfers    AssetTransfer[]   @relation("ApprovedByTransferRelation")
  receivedReturns      AssetReturn[]     @relation("ReceivedByReturnRelation")
  inspectedReturns     AssetReturn[]     @relation("InspectedByReturnRelation")
  approvedReturns      AssetReturn[]     @relation("ApprovedByReturnRelation")
  reportedMaintenance MaintenanceRecord[] @relation("ReportedByMaintenanceRelation")
  assignedMaintenance MaintenanceRecord[] @relation("AssignedToMaintenanceRelation")
  approvedMaintenance MaintenanceRecord[] @relation("ApprovedByMaintenanceRelation")
  historyPerformed     AssetStatusHistory[] @relation("PerformedByRelation")
  historyApproved      AssetStatusHistory[] @relation("ApprovedByHistoryRelation")
  importBatches        ImportBatch[]
  requestedApprovals   ApprovalRequest[] @relation("RequestedByApprovalRelation")
  decidedApprovals     ApprovalRequest[] @relation("DecisionByApprovalRelation")
  approvalHistories    ApprovalHistory[] @relation("ApprovalHistoryPerformedByRelation")
  createdWarranties    Warranty[]        @relation("WarrantyCreatedByRelation")
  createdClaims        WarrantyClaim[]   @relation("ClaimCreatedByRelation")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  managerId   String?
  manager     Employee? @relation("DepartmentManagerRelation", fields: [managerId], references: [id])
  locationId  String?
  location    Location? @relation("DepartmentDefaultLocationRelation", fields: [locationId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  assets    Asset[]
  assignments AssetAssignment[]
  previousTransfers AssetTransfer[] @relation("PreviousDeptRelation")
  newTransfers      AssetTransfer[] @relation("NewDeptRelation")
  previousHistory   AssetStatusHistory[] @relation("PreviousDeptHistoryRelation")
  newHistory        AssetStatusHistory[] @relation("NewDeptHistoryRelation")
  returns           AssetReturn[]
  maintenance       MaintenanceRecord[]
  defaultLocations  Location[] @relation("LocationDefaultDeptRelation")
  targetedApprovals ApprovalRequest[] @relation("ApprovalTargetDeptRelation")

  @@index([name])
  @@index([code])
  @@index([isActive])
  @@index([managerId])
  @@index([locationId])
}

model Location {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  address     String?
  description String?
  building    String?
  floor       String?
  roomZone    String?
  city        String?
  departmentId String?
  department  Department? @relation("LocationDefaultDeptRelation", fields: [departmentId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  assets    Asset[]
  assignments AssetAssignment[]
  previousTransfers AssetTransfer[] @relation("PreviousLocRelation")
  newTransfers      AssetTransfer[] @relation("NewLocRelation")
  previousHistory   AssetStatusHistory[] @relation("PreviousLocationHistoryRelation")
  newHistory        AssetStatusHistory[] @relation("NewLocationHistoryRelation")
  returns           AssetReturn[]
  maintenance       MaintenanceRecord[]
  departmentLocations Department[] @relation("DepartmentDefaultLocationRelation")

  @@index([name])
  @@index([code])
  @@index([isActive])
  @@index([departmentId])
}

model Employee {
  id           String         @id @default(uuid())
  employeeCode String         @unique
  fullName     String
  email        String         @unique
  phone        String?
  designation  String?
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  locationId   String
  location     Location       @relation(fields: [locationId], references: [id])
  joiningDate  DateTime?
  exitDate     DateTime?
  status       EmployeeStatus @default(ACTIVE)
  managerId    String?
  manager      Employee?      @relation("EmployeeManagerRelation", fields: [managerId], references: [id])
  subordinates Employee[]     @relation("EmployeeManagerRelation")
  remarks      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user               User?
  heldAssets         Asset[]          @relation("CurrentHolderRelation")
  assignments        AssetAssignment[]
  previousTransfers  AssetTransfer[]  @relation("PreviousHolderRelation")
  newTransfers       AssetTransfer[]  @relation("NewHolderRelation")
  returns            AssetReturn[]
  technicianMaintenance MaintenanceRecord[] @relation("TechnicianMaintenanceRelation")
  previousHistory    AssetStatusHistory[] @relation("PrevHolderHistoryRelation")
  newHistory         AssetStatusHistory[] @relation("NewHolderHistoryRelation")
  managedDepartments Department[]     @relation("DepartmentManagerRelation")

  @@index([employeeCode])
  @@index([email])
  @@index([departmentId])
  @@index([locationId])
  @@index([status])
  @@index([managerId])
}

model Asset {
  id                      String                   @id @default(uuid())
  assetCode               String                   @unique
  companyAssetId          String?                  @unique
  sourceAssetId           String?                  // Exact raw un-trimmed Excel Asset ID (e.g. " FAA-475", "FAA -349")
  assetName               String?
  assetDescription        String?                  // Exact Excel Asset Description ("In Use", "NOT IN USE", "Site use Laptop")
  assetType               AssetType
  assetNumber             String?
  laptopNumber            String?
  pcNumber                String?
  serialNumber            String?
  manufacturer            String                   @default("Dell")
  model                   String                   @default("Dell 5440")
  description             String?
  status                  AssetStatus              @default(AVAILABLE)
  condition               AssetCondition           @default(GOOD)
  
  // Exact 16 source fields directly on Asset model
  sourceAssetStatus       String?                  // "Active", "Inactive"
  sourceAllocationStatus  String?                  // "Allocated", "Not Allocated"
  sourceAssetType         String?                  // "Laptop", "Office PC", "Work Station"
  location                String?                  // Exact Excel location ("Management", "Automation-PLC", "Design", etc.)
  allocationStatus        AllocationStatus         @default(NOT_ALLOCATED)
  criticality             String?                  // "High", "Medium", or null
  employeeNameSource      String?                  // Exact Excel Employee Name ("Nilesh Pandhare(New)", "Training Room", or null)
  lanIp                   String?                  // Direct LAN IP or null
  ram                     String?                  // Direct RAM or null ("8GB")
  dateOfAllocation        DateTime?                // Direct Date of allocation or null
  dateOfDeallocation      DateTime?                // Direct Date of deallocation or null
  cpu                     String?                  // Direct CPU ("i3", "i5", "i7", "Xeon")
  lanMacAddress           String?                  // Direct LAN Mac Address or null

  holderType              HolderType               @default(UNKNOWN)
  holderDisplayName       String?
  holderVerificationStatus HolderVerificationStatus @default(VERIFIED)

  dataQualityStatus       DataQualityStatus        @default(CLEAN)
  dataQualityIssues       String?

  currentHolderId         String?
  currentHolder           Employee?                @relation("CurrentHolderRelation", fields: [currentHolderId], references: [id], onDelete: SetNull)
  departmentId            String?
  department              Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId              String?
  locationRel             Location?                @relation(fields: [locationId], references: [id], onDelete: SetNull)

  importBatchId           String?
  importBatch             ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  sourceRowNumber         Int?
  sourceRawData           String?                  @db.Text

  purchaseDate            DateTime?
  purchaseCost            Float?
  vendor                  String?
  warrantyStart           DateTime?
  warrantyEnd             DateTime?
  notes                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  specifications          AssetSpecification?
  assignments             AssetAssignment[]
  transfers               AssetTransfer[]
  returns                 AssetReturn[]
  maintenance             MaintenanceRecord[]
  statusHistory           AssetStatusHistory[]
  approvalRequests        ApprovalRequest[]
  warranties              Warranty[]
  warrantyClaims          WarrantyClaim[]

  @@index([assetCode])
  @@index([companyAssetId])
  @@index([assetType])
  @@index([status])
  @@index([condition])
  @@index([allocationStatus])
  @@index([criticality])
  @@index([dataQualityStatus])
  @@index([holderType])
  @@index([serialNumber])
  @@index([currentHolderId])
  @@index([departmentId])
  @@index([locationId])
  @@index([location])
  @@index([lanIp])
  @@index([employeeNameSource])
  @@index([warrantyEnd])
}

model AssetSpecification {
  id                       String   @id @default(uuid())
  assetId                  String   @unique
  asset                    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  processor                String?  // CPU
  ram                      String?  // RAM
  storage                  String?  // Storage (e.g. 512 GB SSD)
  storageType              String?
  gpu                      String?
  displaySize              String?
  monitor                  String?  // Monitor (e.g. Dell 24")
  keyboard                 String?  // Keyboard (e.g. Dell USB)
  mouse                    String?  // Mouse (e.g. Dell USB)
  chargerAdapter           String?  // Charger / Adapter (e.g. 65W)
  otherHardware            String?  // Other Hardware
  operatingSystem          String?
  operatingSystemVersion   String?
  macAddress               String?
  ipAddress                String?
  batteryHealth            String?
  additionalSpecifications String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model AssetAssignment {
  id                    String          @id @default(uuid())
  assignmentCode        String?         @unique
  assetId               String
  asset                 Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId          String?
  department            Department?     @relation(fields: [departmentId], references: [id])
  locationId            String?
  location              Location?       @relation(fields: [locationId], references: [id])
  assignedById          String
  assignedBy            User            @relation("AssignedByRelation", fields: [assignedById], references: [id])
  approvedById          String?
  approvedBy            User?           @relation("ApprovedByAssignmentRelation", fields: [approvedById], references: [id])
  assignedAt            DateTime        @default(now())
  expectedReturnDate    DateTime?
  actualReturnDate      DateTime?
  conditionAtAssignment AssetCondition  @default(GOOD)
  conditionAtReturn     AssetCondition?
  reason                String?
  remarks               String?
  status                WorkflowStatus  @default(ACTIVE)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  returns               AssetReturn[]

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
  @@index([assignedAt])
  @@index([expectedReturnDate])
  @@index([departmentId])
  @@index([locationId])
}

model AssetTransfer {
  id                   String          @id @default(uuid())
  transferCode         String?         @unique
  assetId              String
  asset                Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  previousHolderId     String?
  previousHolder       Employee?       @relation("PreviousHolderRelation", fields: [previousHolderId], references: [id])
  newHolderId          String?
  newHolder            Employee?       @relation("NewHolderRelation", fields: [newHolderId], references: [id])
  previousDepartmentId String?
  previousDepartment   Department?     @relation("PreviousDeptRelation", fields: [previousDepartmentId], references: [id])
  newDepartmentId      String?
  newDepartment        Department?     @relation("NewDeptRelation", fields: [newDepartmentId], references: [id])
  previousLocationId   String?
  previousLocation     Location?       @relation("PreviousLocRelation", fields: [previousLocationId], references: [id])
  newLocationId        String?
  newLocation          Location?       @relation("NewLocRelation", fields: [newLocationId], references: [id])
  requestedById        String
  requestedBy          User            @relation("RequestedByTransferRelation", fields: [requestedById], references: [id])
  approvedById         String?
  approvedBy           User?           @relation("ApprovedByTransferRelation", fields: [approvedById], references: [id])
  transferDate         DateTime        @default(now())
  effectiveDate        DateTime?
  conditionBefore      AssetCondition?
  conditionAfter       AssetCondition?
  reason               String?
  remarks              String?
  status               WorkflowStatus  @default(PENDING)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([assetId])
  @@index([previousHolderId])
  @@index([newHolderId])
  @@index([previousDepartmentId])
  @@index([newDepartmentId])
  @@index([previousLocationId])
  @@index([newLocationId])
  @@index([status])
  @@index([transferDate])
}

model AssetReturn {
  id                  String             @id @default(uuid())
  returnCode          String?            @unique
  assignmentId        String?
  assignment          AssetAssignment?   @relation(fields: [assignmentId], references: [id])
  assetId             String
  asset               Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId          String?
  employee            Employee?          @relation(fields: [employeeId], references: [id])
  departmentId        String?
  department          Department?        @relation(fields: [departmentId], references: [id])
  locationId          String?
  location            Location?          @relation(fields: [locationId], references: [id])
  receivedById        String?
  receivedBy          User?              @relation("ReceivedByReturnRelation", fields: [receivedById], references: [id])
  returnDate          DateTime           @default(now())
  returnReason        String?
  conditionAtReturn   AssetCondition     @default(GOOD)
  accessoriesReturned Boolean            @default(true)
  damageReported      Boolean            @default(false)
  damageCategory      String?
  damageDescription   String?
  missingAccessories  String?
  accessoriesChecklist Json?
  dataWipeStatus      String?            @default("NOT_REQUIRED")
  inspectionRequired  Boolean            @default(true)
  inspectionResult    String?
  inspectedById       String?
  inspectedBy         User?              @relation("InspectedByReturnRelation", fields: [inspectedById], references: [id])
  inspectedAt         DateTime?
  inspectionRemarks   String?
  maintenanceRequired Boolean            @default(false)
  maintenanceId       String?
  maintenance         MaintenanceRecord? @relation(fields: [maintenanceId], references: [id])
  disposition         String?
  approvedById        String?
  approvedBy          User?              @relation("ApprovedByReturnRelation", fields: [approvedById], references: [id])
  remarks             String?
  status              WorkflowStatus     @default(COMPLETED)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([returnCode])
  @@index([assetId])
  @@index([assignmentId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([locationId])
  @@index([status])
  @@index([returnDate])
}

model MaintenanceRecord {
  id                     String            @id @default(uuid())
  maintenanceCode        String?           @unique
  assetId                String
  asset                  Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reportedById           String
  reportedBy             User              @relation("ReportedByMaintenanceRelation", fields: [reportedById], references: [id])
  maintenanceType        String            @default("CORRECTIVE")
  issueTitle             String
  issueDescription       String
  reportedAt             DateTime          @default(now())
  priority               String            @default("MEDIUM")
  repairStatus           MaintenanceStatus @default(OPEN)
  technician             String?
  technicianId           String?
  technicianEmployee     Employee?         @relation("TechnicianMaintenanceRelation", fields: [technicianId], references: [id])
  serviceProvider        String?
  assignedToId           String?
  assignedTo             User?             @relation("AssignedToMaintenanceRelation", fields: [assignedToId], references: [id])
  assignedAt             DateTime?
  diagnosis              String?
  rootCause              String?
  recommendedAction      String?
  repairAction           String?
  partsReplaced          String?
  laborCost              Float?            @default(0.0)
  partsCost              Float?            @default(0.0)
  serviceCost            Float?            @default(0.0)
  otherCost              Float?            @default(0.0)
  repairCost             Float?            @default(0.0)
  underWarranty          Boolean           @default(false)
  warrantyProvider       String?
  warrantyReference      String?
  warrantyClaimNumber    String?
  warrantyExpiry         DateTime?
  warrantyCoverage       String?           @default("NOT_COVERED")
  repairStartDate        DateTime?
  expectedCompletionDate DateTime?
  repairEndDate          DateTime?
  conditionBefore        AssetCondition?   @default(GOOD)
  conditionAfter         AssetCondition?
  resolution             String?
  finalDisposition       String?           @default("AVAILABLE")
  remarks                String?
  approvedById           String?
  approvedBy             User?             @relation("ApprovedByMaintenanceRelation", fields: [approvedById], references: [id])
  departmentId           String?
  department             Department?       @relation(fields: [departmentId], references: [id])
  locationId             String?
  location               Location?         @relation(fields: [locationId], references: [id])
  warrantyId             String?
  warranty               Warranty?         @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  coveredAmount          Float?
  outOfPocketAmount      Float?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  parts                  MaintenancePart[]
  returns                AssetReturn[]
  warrantyClaims         WarrantyClaim[]

  @@index([maintenanceCode])
  @@index([assetId])
  @@index([repairStatus])
  @@index([priority])
  @@index([maintenanceType])
  @@index([reportedAt])
  @@index([expectedCompletionDate])
  @@index([technicianId])
  @@index([departmentId])
  @@index([locationId])
  @@index([warrantyId])
}


model MaintenancePart {
  id            String            @id @default(uuid())
  maintenanceId String
  maintenance   MaintenanceRecord @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  partName      String
  quantity      Int               @default(1)
  cost          Float             @default(0.0)
  remarks       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model AssetStatusHistory {
  id                     String            @id @default(uuid())
  assetId                String
  asset                  Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action                 AssetAction
  previousStatus         AssetStatus?
  newStatus              AssetStatus?
  previousAllocationStatus AllocationStatus?
  newAllocationStatus    AllocationStatus?
  previousHolderId       String?
  previousHolder         Employee?         @relation("PrevHolderHistoryRelation", fields: [previousHolderId], references: [id])
  previousHolderName     String?
  newHolderId            String?
  newHolder              Employee?         @relation("NewHolderHistoryRelation", fields: [newHolderId], references: [id])
  newHolderName          String?
  previousDepartmentId   String?
  previousDepartment     Department?       @relation("PreviousDeptHistoryRelation", fields: [previousDepartmentId], references: [id])
  previousDepartmentName String?
  newDepartmentId        String?
  newDepartment          Department?       @relation("NewDeptHistoryRelation", fields: [newDepartmentId], references: [id])
  newDepartmentName      String?
  previousLocationId     String?
  previousLocation       Location?         @relation("PreviousLocationHistoryRelation", fields: [previousLocationId], references: [id])
  previousLocationName   String?
  newLocationId          String?
  newLocation            Location?         @relation("NewLocationHistoryRelation", fields: [newLocationId], references: [id])
  newLocationName        String?
  previousCondition      AssetCondition?
  newCondition           AssetCondition?
  performedById          String?
  performedBy            User?             @relation("PerformedByRelation", fields: [performedById], references: [id])
  performedByName        String?
  approvedById           String?
  approvedBy             User?             @relation("ApprovedByHistoryRelation", fields: [approvedById], references: [id])
  approvedByName         String?
  relatedEntityType      String?
  relatedEntityId        String?
  relatedRecordCode      String?
  isCorrection           Boolean           @default(false)
  correctedHistoryId     String?
  correctionReason       String?
  snapshot               String?
  eventDate              DateTime          @default(now())
  reason                 String?
  remarks                String?
  metadata               String?
  createdAt              DateTime          @default(now())

  @@index([assetId])
  @@index([action])
  @@index([eventDate])
  @@index([createdAt])
  @@index([performedById])
  @@index([newHolderId])
  @@index([newDepartmentId])
  @@index([newLocationId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([relatedRecordCode])
  @@index([correctedHistoryId])
  @@index([isCorrection])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String
  description String?
  updatedAt   DateTime @updatedAt
}

model ImportBatch {
  id           String         @id @default(uuid())
  fileName     String
  fileHash     String?
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime       @default(now())
  totalRows    Int            @default(0)
  validRows    Int            @default(0)
  warningRows  Int            @default(0)
  errorRows    Int            @default(0)
  importedRows Int            @default(0)
  skippedRows  Int            @default(0)
  status       ImportStatus   @default(READY)

  assets       Asset[]
  rowLogs      ImportRowLog[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([uploadedAt])
}

model ImportRowLog {
  id             String      @id @default(uuid())
  importBatchId  String
  importBatch    ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber      Int
  companyAssetId String?
  status         String      // VALID, WARNING, ERROR, IMPORTED, SKIPPED
  warnings       String?
  errors         String?
  rawData        String      @db.Text
  createdAt      DateTime    @default(now())

  @@index([importBatchId])
  @@index([companyAssetId])
}

model ApprovalRequest {
  id                   String              @id @default(uuid())
  requestCode          String              @unique
  requestType          ApprovalRequestType
  relatedEntityType    String?             // 'AssetAssignment', 'AssetTransfer', 'AssetReturn', 'MaintenanceRecord', 'Asset'
  relatedEntityId      String?
  assetId              String?
  asset                Asset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)
  requestedById        String
  requestedBy          User                @relation("RequestedByApprovalRelation", fields: [requestedById], references: [id])
  requestedAt          DateTime            @default(now())
  status               ApprovalStatus      @default(PENDING)
  priority             ApprovalPriority    @default(MEDIUM)
  reason               String?
  comments             String?
  currentStep          Int                 @default(1)
  totalSteps           Int                 @default(1)
  targetRole           String?             // 'MANAGER', 'ADMIN', 'IT'
  targetDepartmentId   String?
  targetDepartment     Department?         @relation("ApprovalTargetDeptRelation", fields: [targetDepartmentId], references: [id])
  decisionById         String?
  decisionBy           User?               @relation("DecisionByApprovalRelation", fields: [decisionById], references: [id])
  decisionAt           DateTime?
  decisionComment      String?
  rejectionReason      String?
  changesRequested     String?
  cancellationReason   String?
  cancelledAt          DateTime?
  proposedChanges      String              @db.Text
  expectedSourceState  String?             @db.Text
  approvalDeadline     DateTime?
  version              Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  history              ApprovalHistory[]

  @@index([requestCode])
  @@index([requestType])
  @@index([status])
  @@index([priority])
  @@index([assetId])
  @@index([requestedById])
  @@index([decisionById])
  @@index([targetDepartmentId])
  @@index([createdAt])
  @@index([approvalDeadline])
}

model ApprovalHistory {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  step              Int             @default(1)
  action            String          // 'SUBMITTED', 'RESUBMITTED', 'APPROVED', 'REJECTED', 'CHANGES_REQUESTED', 'CANCELLED', 'EXPIRED', 'EXECUTED'
  performedById     String
  performedBy       User            @relation("ApprovalHistoryPerformedByRelation", fields: [performedById], references: [id])
  comment           String?
  snapshot          String?         @db.Text
  createdAt         DateTime        @default(now())

  @@index([approvalRequestId])
  @@index([action])
  @@index([performedById])
  @@index([createdAt])
}

model ApprovalPolicy {
  id                String              @id @default(uuid())
  operationType     ApprovalRequestType @unique
  requiresApproval  Boolean             @default(true)
  approverRole      String?             @default("MANAGER") // 'MANAGER', 'ADMIN', 'IT'
  allowSelfApproval Boolean             @default(false)
  autoExpireDays    Int?
  description       String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([operationType])
  @@index([isActive])
}

model Warranty {
  id                  String            @id @default(uuid())
  warrantyCode        String            @unique
  assetId             String
  asset               Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  warrantyType        WarrantyType      @default(STANDARD)
  provider            String
  policyNumber        String?
  coverageDescription String?
  startDate           DateTime
  endDate             DateTime
  status              CoverageStatus    @default(ACTIVE)
  claimContact        String?
  contactEmail        String?
  contactPhone        String?
  purchaseDate        DateTime?
  purchaseReference   String?
  warrantyCost        Float?
  coverageNotes       String?
  attachmentRef       String?
  isExtended          Boolean           @default(false)
  previousWarrantyId  String?
  previousWarranty    Warranty?         @relation("WarrantyExtensionRelation", fields: [previousWarrantyId], references: [id], onDelete: SetNull)
  extensionWarranties Warranty[]        @relation("WarrantyExtensionRelation")
  extensionReason     String?
  createdById         String
  createdBy           User              @relation("WarrantyCreatedByRelation", fields: [createdById], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  claims              WarrantyClaim[]
  maintenanceRecords  MaintenanceRecord[]

  @@index([warrantyCode])
  @@index([assetId])
  @@index([provider])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([warrantyType])
  @@index([isExtended])
}

model WarrantyClaim {
  id                String            @id @default(uuid())
  claimNumber       String            @unique
  warrantyId        String
  warranty          Warranty          @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  assetId           String
  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  claimDate         DateTime          @default(now())
  issue             String
  description       String
  provider          String
  status            ClaimStatus       @default(SUBMITTED)
  submittedDate     DateTime?         @default(now())
  approvedDate      DateTime?
  serviceDate       DateTime?
  resolvedDate      DateTime?
  resolution        String?
  claimCost         Float?
  warrantyCovered   Boolean           @default(true)
  coveredAmount     Float?
  outOfPocketAmount Float?
  maintenanceId     String?
  maintenance       MaintenanceRecord? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  remarks           String?
  createdById       String
  createdBy         User              @relation("ClaimCreatedByRelation", fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([claimNumber])
  @@index([warrantyId])
  @@index([assetId])
  @@index([status])
  @@index([claimDate])
  @@index([provider])
  @@index([maintenanceId])
}


